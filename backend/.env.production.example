# ==============================================================================
# CampusHub Production Environment Configuration (AWS EC2 + RDS + S3)
# ==============================================================================

NODE_ENV=production
PORT=3000

# 1. AWS RDS PostgreSQL Database
# Format: postgresql://<USER>:<PASSWORD>@<RDS_ENDPOINT>:5432/<DB_NAME>?sslmode=require
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<YOUR_RDS_ENDPOINT>:5432/<DB_NAME>?sslmode=require"

# 2. JWT Authentication (Generate a strong 32+ character random string)
JWT_SECRET="replace-with-a-secure-random-jwt-key-for-production-use"
JWT_EXPIRES_IN=7d

# 3. AWS S3 Storage (for event posters, club logos, and documents)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-campushub-s3-bucket
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# 4. CORS & Security (Set to your EC2 Public IP, Elastic IP, or custom domain)
CORS_ORIGIN="*"

# 5. Rate Limiting (100 requests per 15 minutes per IP on auth routes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
